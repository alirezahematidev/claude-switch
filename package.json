{
  "name": "claude-switch",
  "version": "0.1.3",
  "private": true,
  "description": "Local-first macOS manager for multiple Claude Code accounts",
  "keywords": [
    "accounts",
    "claude",
    "claude-code",
    "macos",
    "tauri"
  ],
  "homepage": "https://github.com/alirezahematidev/claude-switch#readme",
  "bugs": {
    "url": "https://github.com/alirezahematidev/claude-switch/issues"
  },
  "license": "MIT",
  "author": "Claude Switch contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alirezahematidev/claude-switch.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "pnpm ext:package && tauri build --config src-tauri/tauri.release.json",
    "app:release": "node scripts/release.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p e2e/tsconfig.json --noEmit && tsc -p vscode-extension/tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run && vitest run --root vscode-extension",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml --lib export_bindings",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm rust:fmt:check && pnpm rust:lint && pnpm rust:test",
    "lint:fix": "oxlint --type-aware --fix",
    "ext:build": "node -e \"require('node:fs').rmSync('vscode-extension/out', { recursive: true, force: true })\" && tsc -p vscode-extension/tsconfig.build.json",
    "helper:build": "node scripts/build-helper.mjs",
    "helper:dev": "node scripts/build-helper.mjs --dev",
    "ext:package": "pnpm ext:build && pnpm helper:build && cd vscode-extension && vsce package --no-dependencies --out claude-switch-vscode.vsix",
    "ext:publish": "pnpm ext:build && pnpm helper:build && cd vscode-extension && vsce publish --no-dependencies --target darwin-arm64 darwin-x64"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.90.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vscode/vsce": "^4.0.0",
    "jsdom": "30.1.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@12.4.1"
}
