{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the main window. Only the app's own typed commands are granted; there is no filesystem, shell, or HTTP plugin access from the webview.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "allow-get-system-info",
    "allow-refresh-cli-detection",
    "allow-get-diagnostics",
    "allow-open-external-url",
    "allow-reveal-path",
    "allow-pick-claude-executable",
    "allow-quit-app",
    "allow-frontend-ready",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-accounts",
    "allow-create-account",
    "allow-update-account",
    "allow-reorder-accounts",
    "allow-delete-account",
    "allow-refresh-auth-status",
    "allow-start-login",
    "allow-get-login-progress",
    "allow-submit-login-code",
    "allow-open-in-editor",
    "allow-set-editor-account",
    "allow-install-editor-extension",
    "allow-list-conversations",
    "allow-continue-conversation",
    "allow-list-projects",
    "allow-add-project-via-picker",
    "allow-update-project",
    "allow-remove-project",
    "allow-list-sessions",
    "allow-list-open-sessions",
    "allow-start-session",
    "allow-attach-session",
    "allow-write-session",
    "allow-resize-session",
    "allow-stop-session",
    "allow-restart-session",
    "allow-close-session"
  ]
}
